				{
					"name": "GET - 15 Điểm đo vẽ biểu đồ LiveChart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Dữ liệu biểu đồ là mảng chứa các mốc thời gian\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"    if (jsonData.length > 0) {",
									"        pm.expect(jsonData[0]).to.have.property('time');",
									"        pm.expect(jsonData[0]).to.have.property('temp');",
									"        pm.expect(jsonData[0]).to.have.property('humidity');",
									"        pm.expect(jsonData[0]).to.have.property('light');",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
