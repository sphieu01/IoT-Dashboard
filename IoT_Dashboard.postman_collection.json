						"body": {
							"mode": "raw",
							"raw": "{\n  \"device\": \"Fan\",\n  \"action\": \"OFF\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/devices/control",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"devices",
								"control"
							]
						},
						"description": "Gửi lệnh MQTT tắt quạt"
					},
					"response": []
				},
				{
					"name": "GET - Lịch sử thao tác thiết bị (Phân trang)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Phân trang trả về currentPage và mảng data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData).to.have.property('currentPage');",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/devices/history?page=1&limit=10&sort=newest",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"devices",
								"history"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "8"
								},
								{
									"key": "sort",
									"value": "newest"
								}
							]
						},
						"description": "Lấy danh sách lịch sử bật/tắt thiết bị"
					},
					"response": []
				}
			]
		},
