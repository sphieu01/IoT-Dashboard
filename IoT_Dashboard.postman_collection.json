			"name": "1. Thiết Bị (Devices)",
			"item": [
				{
					"name": "GET - Lấy trạng thái thiết bị",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Dữ liệu trả về chứa thông tin đèn và quạt\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('light');",
									"    pm.expect(jsonData).to.have.property('fan');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/devices/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"devices",
								"status"
							]
						},
						"description": "Lấy trạng thái BẬT/TẮT hiện thời của thiết bị (light, fan)"
					},
					"response": []
				},
				{
					"name": "POST - Bật đèn (Light ON)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Phản hồi ghi nhận hành động bật thiết bị thành công\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.device).to.eql(\"Light\");",
									"    pm.expect(jsonData.action).to.eql(\"ON\");",
									"    pm.expect(jsonData).to.have.property('fullTime');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"device\": \"Light\",\n  \"action\": \"ON\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/devices/control",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"devices",
								"control"
							]
						},
						"description": "Gửi lệnh MQTT bật đèn và ghi nhận lịch sử vào CSDL"
					},
					"response": []
				},
				{
					"name": "POST - Tắt quạt (Fan OFF)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Phản hồi ghi nhận hành động tắt quạt\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.device).to.eql(\"Fan\");",
